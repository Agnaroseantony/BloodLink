# Reference only: Spring Boot does not automatically load this file.
# Add these securely in Vercel Project Settings > Environment Variables.
# Set matching values separately for Preview and Production databases.
JDBC_DATABASE_URL=jdbc:postgresql://your-database-host:5432/your-database?sslmode=require
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=replace-in-vercel-settings
# Optional: false disables demo seeding on a new database.
SEED_DEMO=true
