FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -B -ntp dependency:go-offline
COPY src/main ./src/main
RUN mvn -B -ntp -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /workspace/target/bloodlink-1.0.0.jar /app/bloodlink.jar
ENV SPRING_PROFILES_ACTIVE=vercel \
    PORT=8080 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Kolkata"
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/bloodlink.jar"]
